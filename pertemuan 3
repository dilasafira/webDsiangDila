    <header>
        <h1><a href="#" style="color: white; text-decoration: none;">ST Bhinneka</a></h1>
    </header>
    <div class="logo" onclick="showDashboard()">
        <img src="logo kampus.png" alt="Logo ST Bhinneka">
    </div>
